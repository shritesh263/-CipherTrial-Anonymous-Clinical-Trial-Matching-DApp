// ============================================================================
// HEALTH WITNESS EVALUATOR CONTRACT
// Language: Compact (Midnight Blockchain ZK Smart Contract Language)
// Pragma:   language_version 0.23
// Network:  Midnight Preprod Testnet
// ============================================================================

pragma language_version 0.23;

import CompactStandardLibrary;

// Private Witnesses
witness getWitnessPatientAge(): Uint<8>;
witness getWitnessConditionCode(): Uint<16>;
witness getWitnessExclusionCode(): Uint<16>;

export circuit evaluatePrivateWitness(
  minAge:         Uint<8>,
  maxAge:         Uint<8>,
  targetCode:     Uint<16>,
  excludedCode:   Uint<16>
): Boolean {
  const age: Uint<8> = getWitnessPatientAge();
  const condition: Uint<16> = getWitnessConditionCode();
  const exclusion: Uint<16> = getWitnessExclusionCode();

  const isAgeValid: Boolean = (age >= minAge) && (age <= maxAge);
  const isConditionValid: Boolean = (condition == targetCode);
  const isMedicationClean: Boolean = (exclusion != excludedCode);

  const passed: Boolean = isAgeValid && isConditionValid && isMedicationClean;
  const result: Boolean = disclose(passed);
  assert result "EVALUATION_FAILED: Medical witness constraints violated";

  return result;
}
