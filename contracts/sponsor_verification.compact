// ============================================================================
// SPONSOR VERIFICATION REGISTRY CONTRACT
// Language: Compact (Midnight Blockchain ZK Smart Contract Language)
// Pragma:   language_version 0.23
// Network:  Midnight Preprod Testnet
// ============================================================================

pragma language_version 0.23;

import CompactStandardLibrary;

export struct SponsorProfile {
  sponsorKey:     Bytes<32>;
  metadataDigest: Bytes<32>;
  isWhitelisted:  Boolean;
}

// Public Ledger State
export ledger adminKey: Bytes<32>;
export ledger verifiedSponsors: Map<Bytes<32>, SponsorProfile>;
export ledger activeSponsorCounter: Counter;

// Private Witnesses
witness getAdminSecretKey(): Bytes<32>;

// Circuits
export circuit initializeAdmin(initialAdminKey: Bytes<32>): [] {
  adminKey = initialAdminKey;
}

export circuit whitelistSponsor(
  sponsorKey:     Bytes<32>,
  metadataDigest: Bytes<32>
): [] {
  const profile: SponsorProfile = SponsorProfile {
    sponsorKey:     sponsorKey,
    metadataDigest: metadataDigest,
    isWhitelisted:  true
  };

  verifiedSponsors.insert(sponsorKey, profile);
  activeSponsorCounter.increment(1);
}

export circuit revokeSponsor(sponsorKey: Bytes<32>): [] {
  const profile: SponsorProfile = verifiedSponsors.lookup(sponsorKey) as SponsorProfile;
  assert profile.isWhitelisted "SPONSOR_NOT_WHITELISTED: Target sponsor is not active";

  const updated: SponsorProfile = SponsorProfile {
    sponsorKey:     profile.sponsorKey,
    metadataDigest: profile.metadataDigest,
    isWhitelisted:  false
  };

  verifiedSponsors.insert(sponsorKey, updated);
}
