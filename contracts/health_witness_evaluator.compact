// ============================================================================
// MIDNIGHT COMPACT SMART CONTRACT: HEALTH WITNESS EVALUATOR
// Language Version: Compact >= 0.20.0
// Multi-variable arithmetic circuits for complex ZK medical witness evaluation.
// ============================================================================

pragma language_version >= 0.20.0;

export contract HealthWitnessEvaluator {
  constructor() {}

  // --------------------------------------------------------------------------
  // CIRCUIT 1: Complex Medical Witness Evaluator
  // Computes multi-parameter clinical trial eligibility in ZK:
  // - Age bounds [minAge <= age <= maxAge]
  // - ICD-10 Condition Code equality
  // - Excluded medication mismatch
  // - Biomarker threshold check (e.g. HbA1c > minBiomarker)
  // --------------------------------------------------------------------------
  export circuit evaluateComplexHealthWitness(
    patientAge: Uint<32>,
    patientConditionCode: Uint<32>,
    patientMedicationCode: Uint<32>,
    patientBiomarkerValue: Uint<32>,
    minAge: Uint<32>,
    maxAge: Uint<32>,
    reqConditionCode: Uint<32>,
    exclMedicationCode: Uint<32>,
    minBiomarkerThreshold: Uint<32>
  ): Boolean {
    // 1. Age Range Constraint
    const ageValid = (patientAge >= minAge) && (patientAge <= maxAge);

    // 2. Condition Code Constraint
    const conditionValid = (patientConditionCode == reqConditionCode);

    // 3. Excluded Medication Constraint
    const medicationValid = (patientMedicationCode != exclMedicationCode);

    // 4. Biomarker Threshold Constraint
    const biomarkerValid = (patientBiomarkerValue >= minBiomarkerThreshold);

    // Overall eligibility boolean
    const isEligible = ageValid && conditionValid && medicationValid && biomarkerValid;

    // Disclose ONLY the final boolean validity bit
    disclose(isEligible);
    return isEligible;
  }
}
