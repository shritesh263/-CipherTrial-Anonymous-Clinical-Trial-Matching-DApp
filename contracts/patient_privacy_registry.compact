// ============================================================================
// PATIENT PRIVACY REGISTRY CONTRACT
// Language: Compact (Midnight Blockchain ZK Smart Contract Language)
// Pragma:   language_version 0.23
// Network:  Midnight Preprod Testnet
// ============================================================================

pragma language_version 0.23;

import CompactStandardLibrary;

export struct PatientCommitmentRecord {
  commitmentHash: Bytes<32>;
  registeredAt:   Uint<64>;
  isActive:       Boolean;
}

// Public Ledger State
export ledger patientCommitments: Map<Bytes<32>, PatientCommitmentRecord>;
export ledger totalRegisteredPatients: Counter;
export ledger revokedNullifiers: Map<Bytes<32>, Boolean>;

// Private Witnesses (local off-chain only)
witness getPatientSecretKey(): Bytes<32>;
witness getPatientSalt(): Bytes<32>;

// Circuits
export circuit registerPatientCommitment(timestamp: Uint<64>): Bytes<32> {
  const secretKey: Bytes<32> = getPatientSecretKey();
  const salt: Bytes<32> = getPatientSalt();

  // Compute off-chain commitment hash in ZK
  const commitmentHash: Bytes<32> = disclose(sha256(pad(64, secretKey || salt)));

  const alreadyExists: Boolean = patientCommitments.lookup(commitmentHash).isActive as Boolean;
  assert !alreadyExists "PATIENT_COMMITMENT_ALREADY_EXISTS: Commitment is already registered";

  const record: PatientCommitmentRecord = PatientCommitmentRecord {
    commitmentHash: commitmentHash,
    registeredAt:   timestamp,
    isActive:       true
  };

  patientCommitments.insert(commitmentHash, record);
  totalRegisteredPatients.increment(1);

  return commitmentHash;
}

export circuit revokePatientConsent(nullifierHash: Bytes<32>): [] {
  const isRevoked: Boolean = revokedNullifiers.lookup(nullifierHash) as Boolean;
  assert !isRevoked "ALREADY_REVOKED: Nullifier consent has already been revoked";

  revokedNullifiers.insert(nullifierHash, true);
}
