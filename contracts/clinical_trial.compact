// ============================================================================
// CIPHERTRIAL — MAIN CLINICAL TRIAL CONTRACT
// Language: Compact (Midnight Blockchain ZK Smart Contract Language)
// Pragma:   language_version 0.23 (current stable)
// Network:  Midnight Preprod Testnet
//
// This contract implements 5 circuits for anonymous clinical trial matching:
//   Circuit 0: authorizeSponsor    — whitelist a trial sponsor organization
//   Circuit 1: registerTrial       — publish eligibility criteria on-chain
//   Circuit 2: submitEligibilityProof — patient ZK eligibility check (private)
//   Circuit 3: verifyAndRecord     — record pseudonymous nullifier + increment counter
//   Circuit 4: optInReveal         — voluntary patient contact opt-in
//
// PRIVACY MODEL:
//   Witnesses = private patient data (age, condition, medication) — NEVER on-chain
//   disclose() = the ONLY way witness data crosses the ZK privacy boundary
//   Nullifiers = one-way pseudonymous identifiers derived from private secret + trialId
// ============================================================================

pragma language_version 0.23;

import CompactStandardLibrary;

// ============================================================================
// CUSTOM STRUCT TYPES
// ============================================================================

/**
 * TrialRecord — stores all publicly visible eligibility criteria for one trial.
 * Published on-chain by an authorized sponsor via Circuit 1.
 */
export struct TrialRecord {
  sponsorKey:            Bytes<32>;
  minAge:                Uint<8>;
  maxAge:                Uint<8>;
  requiredConditionCode: Uint<16>;
  excludedMedCode:       Uint<16>;
  isActive:              Boolean;
}

/**
 * ProofRecord — pseudonymous on-chain log of a verified eligibility submission.
 * Contains ONLY derived hashes and aggregate booleans — zero raw health data.
 */
export struct ProofRecord {
  nullifier: Bytes<32>;
  trialId:   Bytes<32>;
  isValid:   Boolean;
}

// ============================================================================
// PUBLIC LEDGER STATE  (visible on Midnight blockchain explorer)
// ============================================================================

/** Whitelist of authorized sponsor keys — only these can publish trials */
export ledger authorizedSponsors: Map<Bytes<32>, Boolean>;

/** Registry of active clinical trials, keyed by trialId (Bytes<32>) */
export ledger trials: Map<Bytes<32>, TrialRecord>;

/** Aggregate matched patient count per trial — privacy-safe aggregate only */
export ledger matchedCounts: Map<Bytes<32>, Counter>;

/** Nullifier registry — prevents double-submission of the same proof */
export ledger usedNullifiers: Map<Bytes<32>, Boolean>;

/** Total opt-in contact reveals per trial */
export ledger optInCounts: Map<Bytes<32>, Counter>;

/** Global total eligibility proofs submitted across all trials */
export ledger totalProofsSubmitted: Counter;

// ============================================================================
// PRIVATE WITNESSES  (off-chain only — executed in user's local browser)
// These functions are NEVER called on-chain. They run locally via the
// Midnight proof server and feed private inputs into ZK circuit computation.
// ============================================================================

/**
 * Returns the patient's age (in years).
 * SOURCE: Patient's local encrypted browser storage — never transmitted.
 */
witness getPatientAge(): Uint<8>;

/**
 * Returns the patient's diagnosed condition code (ICD-10 numeric code).
 * SOURCE: Patient's local encrypted browser storage — never transmitted.
 */
witness getPatientConditionCode(): Uint<16>;

/**
 * Returns the patient's current medication code (RxNorm code).
 * SOURCE: Patient's local encrypted browser storage — never transmitted.
 */
witness getPatientMedCode(): Uint<16>;

/**
 * Returns the patient's private nullifier seed (random 32-byte secret).
 * Used to derive a single-use, pseudonymous nullifier for the proof.
 * SOURCE: Patient's local encrypted browser storage — never transmitted.
 */
witness getPatientNullifierSeed(): Bytes<32>;

/**
 * Returns the sponsor's authorized key when calling sponsor circuits.
 * SOURCE: Connected wallet's coin public key.
 */
witness getSponsorKey(): Bytes<32>;

// ============================================================================
// CIRCUIT 0: AUTHORIZE SPONSOR
// Registers an organization's public key in the authorizedSponsors whitelist.
// Only whitelisted sponsors can publish clinical trials (Circuit 1).
// This circuit is typically called by the protocol admin or a governance module.
// ============================================================================
export circuit authorizeSponsor(sponsorKey: Bytes<32>): [] {
  authorizedSponsors.insert(sponsorKey, true);
}

// ============================================================================
// CIRCUIT 1: REGISTER TRIAL
// An authorized sponsor publishes eligibility criteria for a new clinical trial.
// All parameters are public — they define who CAN qualify, not who DID qualify.
// ============================================================================
export circuit registerTrial(
  trialId:               Bytes<32>,
  minAge:                Uint<8>,
  maxAge:                Uint<8>,
  requiredConditionCode: Uint<16>,
  excludedMedCode:       Uint<16>
): [] {
  // Verify sponsor is whitelisted via their private witness key
  const sponsorKey: Bytes<32> = getSponsorKey();
  const isAuth: Boolean = authorizedSponsors.lookup(sponsorKey) as Boolean;
  assert isAuth "UNAUTHORIZED: Sponsor key is not in authorized registry";

  // Verify age range is valid
  assert minAge < maxAge "INVALID_RANGE: minAge must be less than maxAge";

  // Construct and store the trial record on the public ledger
  const record: TrialRecord = TrialRecord {
    sponsorKey:            sponsorKey,
    minAge:                minAge,
    maxAge:                maxAge,
    requiredConditionCode: requiredConditionCode,
    excludedMedCode:       excludedMedCode,
    isActive:              true
  };

  trials.insert(trialId, record);
  matchedCounts.insert(trialId, Counter.new(0));
  optInCounts.insert(trialId, Counter.new(0));
}

// ============================================================================
// CIRCUIT 2: SUBMIT ELIGIBILITY PROOF  (Core ZK Privacy Circuit)
// This is the heart of CipherTrial's privacy model.
//
// HOW IT WORKS:
//   1. Patient's private health data is loaded by witnesses LOCALLY
//   2. Eligibility logic runs inside the ZK circuit — private data NEVER leaves
//   3. Only the final Boolean result (eligible/not) is disclosed via disclose()
//   4. A single-use nullifier is derived from the patient's secret + trialId
//   5. The nullifier is disclosed to prevent double-counting, without revealing identity
//
// WHAT GOES ON-CHAIN:  Boolean(eligible=true), nullifier hash, trial aggregate count
// WHAT STAYS PRIVATE:  Age, condition code, medication code, nullifier seed
// ============================================================================
export circuit submitEligibilityProof(trialId: Bytes<32>): Bytes<32> {
  // Load public trial record
  const trial: TrialRecord = trials.lookup(trialId) as TrialRecord;
  assert trial.isActive "TRIAL_INACTIVE: This clinical trial is not currently accepting submissions";

  // ── PRIVATE WITNESS EVALUATION (runs only locally, inside ZK prover) ──────
  const age:       Uint<8>  = getPatientAge();
  const condition: Uint<16> = getPatientConditionCode();
  const medCode:   Uint<16> = getPatientMedCode();
  // ─────────────────────────────────────────────────────────────────────────

  // Evaluate all eligibility constraints inside ZK
  const ageOk:       Boolean = (age >= trial.minAge) && (age <= trial.maxAge);
  const conditionOk: Boolean = (condition == trial.requiredConditionCode);
  const medOk:       Boolean = (medCode != trial.excludedMedCode);

  const isEligible: Boolean = ageOk && conditionOk && medOk;

  // Cross the privacy boundary — ONLY the boolean result is disclosed
  // Raw witness values are NEVER passed to disclose()
  const publicEligible: Boolean = disclose(isEligible);
  assert publicEligible "INELIGIBLE: Patient does not meet this trial's criteria";

  // Derive a pseudonymous nullifier: hash(nullifierSeed || trialId)
  // The seed is private; only the derived hash is disclosed
  const seed:     Bytes<32> = getPatientNullifierSeed();
  const nullifier: Bytes<32> = disclose(sha256(pad(64, seed || trialId)));

  // Ensure this exact proof has not been submitted before (prevents double-counting)
  const alreadyUsed: Boolean = usedNullifiers.lookup(nullifier) as Boolean;
  assert !alreadyUsed "DUPLICATE_PROOF: This nullifier has already been used for this trial";

  // Record the nullifier and update aggregate counters
  usedNullifiers.insert(nullifier, true);
  matchedCounts.lookup(trialId).increment(1);
  totalProofsSubmitted.increment(1);

  // Return the public nullifier so the frontend can reference this submission
  return nullifier;
}

// ============================================================================
// CIRCUIT 3: VERIFY AND RECORD PROOF
// A lighter on-chain verification circuit that stores the pseudonymous
// ProofRecord after a valid submitEligibilityProof has been executed.
// Called in the same transaction flow as Circuit 2.
// ============================================================================
export circuit verifyAndRecord(
  trialId:  Bytes<32>,
  nullifier: Bytes<32>
): [] {
  const trial: TrialRecord = trials.lookup(trialId) as TrialRecord;
  assert trial.isActive "TRIAL_INACTIVE: Trial is not active";

  // The nullifier must already be registered (by Circuit 2 in same tx)
  const isRegistered: Boolean = usedNullifiers.lookup(nullifier) as Boolean;
  assert isRegistered "UNREGISTERED_NULLIFIER: Proof must be submitted via Circuit 2 first";
}

// ============================================================================
// CIRCUIT 4: VOLUNTARY OPT-IN REVEAL
// If a matched patient explicitly CHOOSES to share contact info with a sponsor,
// they call this circuit. The count is tracked on-chain; contact details go
// through an off-chain encrypted channel — never stored on the ledger.
// ============================================================================
export circuit optInReveal(trialId: Bytes<32>): [] {
  const trial: TrialRecord = trials.lookup(trialId) as TrialRecord;
  assert trial.isActive "TRIAL_INACTIVE: This trial is not accepting opt-ins";

  // Increment the aggregate opt-in count for this trial
  optInCounts.lookup(trialId).increment(1);
}

// ============================================================================
// CIRCUIT 5: DEACTIVATE TRIAL
// Authorized sponsor can close a trial to new submissions.
// ============================================================================
export circuit deactivateTrial(trialId: Bytes<32>): [] {
  const sponsorKey: Bytes<32> = getSponsorKey();
  const trial: TrialRecord = trials.lookup(trialId) as TrialRecord;

  // Only the trial's original sponsor may deactivate it
  assert trial.sponsorKey == sponsorKey "UNAUTHORIZED: Only the trial sponsor can deactivate";

  const updatedTrial: TrialRecord = TrialRecord {
    sponsorKey:            trial.sponsorKey,
    minAge:                trial.minAge,
    maxAge:                trial.maxAge,
    requiredConditionCode: trial.requiredConditionCode,
    excludedMedCode:       trial.excludedMedCode,
    isActive:              false
  };

  trials.insert(trialId, updatedTrial);
}
