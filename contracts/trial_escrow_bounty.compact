// ============================================================================
// TRIAL ESCROW BOUNTY SMART CONTRACT
// Language: Compact (Midnight Blockchain ZK Smart Contract Language)
// Pragma:   language_version 0.23
// Network:  Midnight Preprod Testnet
// ============================================================================

pragma language_version 0.23;

import CompactStandardLibrary;

export struct EscrowVault {
  trialId:         Bytes<32>;
  sponsorKey:      Bytes<32>;
  bountyPerMatch:  Uint<64>;
  totalAllocated:  Uint<64>;
  totalClaimed:    Uint<64>;
  isFunded:        Boolean;
}

// Public Ledger State
export ledger trialEscrows: Map<Bytes<32>, EscrowVault>;
export ledger totalBountyDistributed: Counter;
export ledger claimedBountyNullifiers: Map<Bytes<32>, Boolean>;

// Circuits
export circuit fundTrialEscrow(
  trialId:        Bytes<32>,
  sponsorKey:     Bytes<32>,
  bountyPerMatch: Uint<64>,
  totalFunding:   Uint<64>
): [] {
  assert totalFunding >= bountyPerMatch "INVALID_FUNDING: Total funding must cover at least one match bounty";

  const vault: EscrowVault = EscrowVault {
    trialId:        trialId,
    sponsorKey:     sponsorKey,
    bountyPerMatch: bountyPerMatch,
    totalAllocated: totalFunding,
    totalClaimed:   0,
    isFunded:       true
  };

  trialEscrows.insert(trialId, vault);
}

export circuit claimMatchBounty(
  trialId:   Bytes<32>,
  nullifier: Bytes<32>
): [] {
  const vault: EscrowVault = trialEscrows.lookup(trialId) as EscrowVault;
  assert vault.isFunded "ESCROW_UNFUNDED: Target trial escrow is not funded";

  const alreadyClaimed: Boolean = claimedBountyNullifiers.lookup(nullifier) as Boolean;
  assert !alreadyClaimed "BOUNTY_ALREADY_CLAIMED: Nullifier has already claimed this trial bounty";

  claimedBountyNullifiers.insert(nullifier, true);
  totalBountyDistributed.increment(1);
}
