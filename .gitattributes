# ============================================================================
# GITHUB LINGUIST LANGUAGE ATTRIBUTES & VENDOR OVERRIDES
# Enables GitHub to detect and highlight Compact, Rust, Solidity, JavaScript, TypeScript, and CSS
# ============================================================================

# Declare Compact smart contract language detection
*.compact linguist-language=Compact
*.compact linguist-detectable=true
*.compact text

# Declare Rust language detection
*.rs linguist-language=Rust
*.rs linguist-detectable=true
*.rs text

# Declare Solidity smart contract language detection
*.sol linguist-language=Solidity
*.sol linguist-detectable=true
*.sol text

# Declare JavaScript language detection
*.js linguist-language=JavaScript
*.js linguist-detectable=true
*.js text

# Balance repository language statistics
src/components/* linguist-vendored
src/providers/* linguist-vendored
src/wallet/* linguist-vendored
dist/* linguist-vendored
node_modules/* linguist-vendored
package-lock.json linguist-vendored
