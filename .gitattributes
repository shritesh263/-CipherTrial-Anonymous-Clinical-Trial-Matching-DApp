# ============================================================================
# GITHUB LINGUIST LANGUAGE STATS OVERRIDES
# Configures language classification for Compact, Rust, JavaScript, and TypeScript
# ============================================================================

# Declare Compact smart contract language (Midnight Blockchain)
*.compact linguist-language=Compact
*.compact linguist-detectable=true

# Explicitly purge Solidity from Linguist detection
*.sol linguist-detectable=false
*.sol linguist-vendored=true
*.sol linguist-documentation=true

# Declare Rust ZK Prover crate
*.rs linguist-language=Rust
*.rs linguist-detectable=true

# Declare JavaScript utilities
*.js linguist-language=JavaScript
*.js linguist-detectable=true

# Vendor boilerplate UI components to give equal language percentage representation to smart contracts and engines
src/components/** linguist-vendored=true
src/providers/** linguist-vendored=true
src/wallet/** linguist-vendored=true
src/config/** linguist-vendored=true
src/contracts/** linguist-vendored=true
dist/** linguist-vendored=true
node_modules/** linguist-vendored=true
